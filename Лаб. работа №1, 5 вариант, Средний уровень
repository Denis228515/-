#include <iostream> // Подключаем заголовочный файл
#include <windows.h> // Используем файл для того, чтобы Кириллица работала корректно при выводе текста
using namespace std; // Открываем стандартное пространство имен
int main() { // Объявляем главную функцию
	SetConsoleCP(65001); // Установка кодировки UTF-8 в консоли на ввод
	SetConsoleOutputCP(65001); // Установка кодировки UTF-8 в консоли на вывод
	float π = 3.14, radius, lon, square; // Вводим переменные
	cout << "Введите радиус "; // Вывод текста на экран
	cin >> radius; // Ввод с клавиатуры
	lon = 2 * π * radius; // Придаем значения двум переменным
	square = π * radius * radius;
	cout << "Длина окружности равна " << lon << " Площадь круга равна " << square; // Вывод на экран
	return 0; // Сообщаем, что программа завершена успешно
}
